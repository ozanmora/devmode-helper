default_platform(:android)

platform :android do
  desc "Uygulamayı derler ve build/devmode-helper.apk dosyasını üretir"
  lane :build do
    project_dir = File.expand_path("..", __dir__)
    sh("cd '#{project_dir}' && ./build.sh")
    UI.success("✅ Derleme başarılı: build/devmode-helper.apk")
  end

  desc "APK derler, sürüm ve build number ile git tag koyar, GitHub'da pre-release olarak yayınlar"
  lane :prerelease do |options|
    project_dir = File.expand_path("..", __dir__)
    manifest_path = File.join(project_dir, "AndroidManifest.xml")
    manifest_content = File.read(manifest_path)

    version_code = options[:build_number] || manifest_content[/android:versionCode="(\d+)"/, 1]
    version_name = options[:version] || manifest_content[/android:versionName="([^"]+)"/, 1]

    UI.user_error!("AndroidManifest.xml dosyasından sürüm bilgileri okunamadı!") unless version_name && version_code

    # Sürüm ve build number ile tag (örn. v1.13.0-b14)
    tag_name = options[:tag] || "v#{version_name}-b#{version_code}"
    release_title = options[:title] || "DevMode Helper #{version_name} (Build #{version_code})"

    UI.message("🚀 Pre-release başlatılıyor:")
    UI.message("   🏷️  Tag:          #{tag_name}")
    UI.message("   📌 Sürüm:        #{version_name} (Build #{version_code})")
    UI.message("   📝 Başlık:       #{release_title}")

    # 1. APK derleme
    sh("cd '#{project_dir}' && ./build.sh")
    apk_source = File.join(project_dir, "build", "devmode-helper.apk")
    UI.user_error!("Derleme çıktısı bulunamadı: #{apk_source}") unless File.exist?(apk_source)

    # 2. Sürüm isimli APK ve SHA-256 sağlama dosyası
    versioned_apk_name = "devmode-helper-#{version_name}.apk"
    versioned_apk_path = File.join(project_dir, "build", versioned_apk_name)
    FileUtils.cp(apk_source, versioned_apk_path)

    sha256 = `shasum -a 256 "#{versioned_apk_path}"`.strip.split.first
    sha_file_name = "#{versioned_apk_name}.sha256"
    sha_file_path = File.join(project_dir, "build", sha_file_name)
    File.write(sha_file_path, "#{sha256}  #{versioned_apk_name}\n")

    # 3. Sürüm notlarını hazırla (CHANGELOG.md veya parametreden)
    changelog_path = File.join(project_dir, "CHANGELOG.md")
    notes = options[:notes]
    if notes.nil? && File.exist?(changelog_path)
      changelog = File.read(changelog_path)
      match = changelog.match(/## \[#{Regexp.escape(version_name)}\][^\n]*\n(.*?)(?=\n## \[|\z)/m)
      notes = match[1].strip if match
    end
    notes ||= "DevMode Helper #{version_name} (Build #{version_code}) pre-release sürümü."

    release_body = <<~MARKDOWN
      ## Yenilikler (v#{version_name} - Build #{version_code})

      #{notes}

      ## Kurulum
      Gereksinim: Android 14 veya üzeri.

      ```bash
      adb install -r #{versioned_apk_name}
      adb shell pm grant works.mora.devmode android.permission.WRITE_SECURE_SETTINGS
      ```

      ## Doğrulama
      - **SHA-256**: `#{sha256}`
      - **Git Tag**: `#{tag_name}`
    MARKDOWN

    notes_file_path = File.join(project_dir, "build", "RELEASE_NOTES.md")
    File.write(notes_file_path, release_body)

    # 4. Git tag oluşturma ve push etme
    UI.message("📌 Git tag kontrolü yapılıyor...")
    tag_exists_local = system("git rev-parse --verify 'refs/tags/#{tag_name}' >/dev/null 2>&1")
    unless tag_exists_local
      sh("git tag -a '#{tag_name}' -m '#{release_title}'")
      UI.message("✓ Yerel git tag oluşturuldu: #{tag_name}")
    end

    UI.message("📤 Git tag GitHub'a push ediliyor...")
    sh("git push origin '#{tag_name}'")

    # 5. GitHub Pre-Release oluşturma (gh CLI)
    UI.message("📦 GitHub'a pre-release yükleniyor...")
    sh("gh release create '#{tag_name}' '#{versioned_apk_path}' '#{sha_file_path}' --title '#{release_title}' --notes-file '#{notes_file_path}' --prerelease")

    UI.success("🎉 Pre-release başarıyla yayınlandı!")
    UI.message("🔗 Kontrol etmek için: gh release view #{tag_name} --repo ozanmora/devmode-helper")
  end
end
